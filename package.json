{
  "name": "lm-clipper",
  "description": "An application for creating melee clips",
  "version": "3.0.0",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.15"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/madenney/lm-clipper.git"
  },
  "homepage": "https://github.com/madenney/lm-clipper",
  "bugs": {
    "url": "https://github.com/madenney/lm-clipper/issues"
  },
  "keywords": [
    "melee",
    "slippi",
    "clips",
    "dolphin",
    "electron",
    "video"
  ],
  "author": {
    "name": "Matt Denney",
    "email": "matt.a.denney@gmail.com"
  },
  "main": "./.erb/dll/main.bundle.dev.js",
  "scripts": {
    "build": "concurrently \"npm run build:main\" \"npm run build:renderer\" && npm run check:release",
    "build:main": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.main.prod.ts",
    "build:renderer": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.renderer.prod.ts",
    "postinstall": "ts-node .erb/scripts/check-native-dep.js && electron-builder install-app-deps && cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.renderer.dev.dll.ts",
    "lint": "cross-env NODE_ENV=development eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:ratchet": "node ./.erb/scripts/tsc-ratchet.js",
    "package": "ts-node ./.erb/scripts/clean.js dist && npm run build && electron-builder build --publish never",
    "check:release": "node scripts/check-release-clean.js",
    "check:metadata": "node .erb/scripts/check-release-metadata.js",
    "fetch:ffmpeg": "node .erb/scripts/fetch-ffmpeg.js",
    "build:slpz": "node .erb/scripts/build-slpz.js",
    "rebuild": "electron-rebuild --parallel --types prod,dev,optional --module-dir release/app",
    "start": "ts-node ./.erb/scripts/check-port-in-use.js && npm run start:renderer",
    "_start:main": "cross-env NODE_ENV=development electronmon -r ts-node/register/transpile-only .",
    "start:main": "cross-env NODE_ENV=development  TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.main.dev.ts && electronmon .",
    "start:preload": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.preload.dev.ts",
    "start:renderer": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack serve --config ./.erb/configs/webpack.config.renderer.dev.ts",
    "test": "jest"
  },
  "browserslist": [],
  "prettier": {
    "singleQuote": true,
    "semi": false,
    "overrides": [
      {
        "files": [
          ".prettierrc",
          ".eslintrc"
        ],
        "options": {
          "parser": "json"
        }
      }
    ]
  },
  "jest": {
    "moduleDirectories": [
      "node_modules",
      "release/app/node_modules",
      "src"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx",
      "json"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/.erb/mocks/fileMock.js",
      "\\.(css|less|sass|scss)$": "identity-obj-proxy",
      ".*/stageVariantAssets$": "<rootDir>/.erb/mocks/stageVariantAssets.js",
      ".*/clipAssets$": "<rootDir>/.erb/mocks/clipAssets.js",
      ".*/GpuLayer$": "<rootDir>/.erb/mocks/GpuLayer.js",
      "^slippi-dolphin-runner$": "<rootDir>/node_modules/slippi-dolphin-runner/dist/index.js",
      "^yauzl$": "<rootDir>/node_modules/yauzl"
    },
    "setupFiles": [
      "./.erb/scripts/check-build-exists.ts"
    ],
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost/"
    },
    "modulePathIgnorePatterns": [
      "release/app"
    ],
    "testPathIgnorePatterns": [
      "release/app/dist",
      ".erb/dll"
    ],
    "transform": {
      "[\\\\/]slippi-dolphin-runner[\\\\/]dist[\\\\/].+\\.js$": "<rootDir>/.erb/scripts/jest-runner-transform.js",
      "\\.(ts|tsx|js|jsx)$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.jest.json"
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!slippi-dolphin-runner/)"
    ]
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/language": "^6.12.2",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.15",
    "@gcpreston/slippi-viewer": "0.1.16",
    "@napi-rs/canvas": "^1.0.0",
    "@slippi/slippi-js": "^6.6.1",
    "electron-debug": "^3.2.0",
    "jszip": "^3.10.1",
    "lodash": "^4.17.21",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "slippi-dolphin-runner": "github:madenney/dolphin_runner#v0.5.8",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@electron/notarize": "^2.0.0",
    "@electron/rebuild": "^4.0.3",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.10",
    "@svgr/webpack": "^6.5.1",
    "@teamsupercell/typings-for-css-modules-loader": "^2.5.2",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.4.0",
    "@types/lodash": "^4.14.195",
    "@types/node": "18.13.0",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "@types/react-test-renderer": "^18.0.0",
    "@types/terser-webpack-plugin": "^5.0.4",
    "@types/webpack-bundle-analyzer": "^4.6.0",
    "@types/yauzl": "^3.4.0",
    "@typescript-eslint/eslint-plugin": "^5.51.0",
    "@typescript-eslint/parser": "^5.51.0",
    "browserslist-config-erb": "^0.0.3",
    "chalk": "^4.1.2",
    "concurrently": "^7.6.0",
    "core-js": "^3.27.2",
    "cross-env": "^7.0.3",
    "css-loader": "^6.7.3",
    "css-minimizer-webpack-plugin": "^4.2.2",
    "detect-port": "^1.5.1",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.0",
    "electron-devtools-installer": "^3.2.0",
    "electronmon": "^2.0.2",
    "eslint": "^8.33.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-erb": "^4.0.6",
    "eslint-import-resolver-typescript": "^3.5.3",
    "eslint-import-resolver-webpack": "^0.13.2",
    "eslint-plugin-compat": "^4.1.1",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jest": "^27.2.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.5.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.4.2",
    "jest-environment-jsdom": "^29.4.2",
    "mini-css-extract-plugin": "^2.7.2",
    "prettier": "^3.0.0",
    "react-icons": "^5.2.1",
    "react-refresh": "^0.14.0",
    "react-test-renderer": "^18.2.0",
    "rimraf": "^4.1.2",
    "sass": "^1.58.0",
    "sass-loader": "^13.2.0",
    "style-loader": "^3.3.1",
    "terser-webpack-plugin": "^5.3.6",
    "ts-jest": "^29.0.5",
    "ts-loader": "^9.4.2",
    "ts-node": "^10.9.1",
    "tsconfig-paths-webpack-plugin": "^4.0.0",
    "typescript": "^4.9.5",
    "url-loader": "^4.1.1",
    "webpack": "^5.75.0",
    "webpack-bundle-analyzer": "^4.7.0",
    "webpack-cli": "^5.0.1",
    "webpack-dev-server": "^5.2.3",
    "webpack-merge": "^5.8.0"
  },
  "build": {
    "productName": "Lunar Clipper",
    "appId": "com.github.madenney.lm-clipper",
    "fileAssociations": [
      {
        "ext": "lunar",
        "name": "Lunar Clipper Project",
        "description": "Lunar Clipper Project",
        "role": "Editor"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.{node,dll}"
    ],
    "files": [
      "dist",
      "node_modules",
      "package.json"
    ],
    "afterSign": ".erb/scripts/notarize.js",
    "beforePack": ".erb/scripts/check-bundled-binaries.js",
    "generateUpdatesFilesForAllChannels": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "notarize": false,
      "extraResources": [
        {
          "from": "release/app/ffmpeg/ffmpeg-darwin-${arch}",
          "to": "ffmpeg/ffmpeg-darwin-${arch}"
        },
        {
          "from": "release/app/slpz/slpz-darwin-${arch}",
          "to": "slpz/slpz-darwin-${arch}"
        }
      ],
      "gatekeeperAssess": false,
      "artifactName": "Lunar-Clipper-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "release/app/ffmpeg/ffmpeg-win32-x64.exe",
          "to": "ffmpeg/ffmpeg-win32-x64.exe"
        },
        {
          "from": "release/app/slpz/slpz-win32-x64.exe",
          "to": "slpz/slpz-win32-x64.exe"
        },
        {
          "from": "node_modules/slippi-dolphin-runner/native/win/bin/lunar-hidden-launcher.exe",
          "to": "hidden-launcher/lunar-hidden-launcher.exe"
        }
      ],
      "artifactName": "Lunar-Clipper-Setup-${version}.${ext}"
    },
    "nsis": {
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "deb": {
      "recommends": [
        "libappindicator3-1",
        "xdotool",
        "x11-utils",
        "wmctrl"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "extraResources": [
        {
          "from": "release/app/ffmpeg/ffmpeg-linux-x64",
          "to": "ffmpeg/ffmpeg-linux-x64"
        },
        {
          "from": "release/app/slpz/slpz-linux-x64",
          "to": "slpz/slpz-linux-x64"
        }
      ],
      "artifactName": "Lunar-Clipper-${version}.${ext}"
    },
    "directories": {
      "app": "release/app",
      "buildResources": "assets",
      "output": "release/build"
    },
    "extraResources": [
      "./assets/**",
      "./LICENSE",
      "./THIRD_PARTY_NOTICES.md"
    ],
    "publish": {
      "provider": "github",
      "owner": "madenney",
      "repo": "lm-clipper"
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.15"
    }
  },
  "electronmon": {
    "patterns": [
      "!**/**",
      "src/main/**"
    ],
    "logLevel": "quiet"
  }
}
